# ============================================================
# DailyFeed · 环境变量模板
# ============================================================
# ⚠️ 使用步骤：
#    1) cp .env.example .env （Windows: copy .env.example .env）
#    2) 用你自己的真实值填充 .env
#    3) 千万不要把 .env 提交到仓库（.gitignore 已配置排除）
# ⚠️ 不要在 .env.example 中写任何真实 API Key / 密码 / 邮箱！
# ============================================================

# ---------- App ----------
APP_NAME=DailyFeed
ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ---------- Database ----------
POSTGRES_USER=dailyfeed
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dailyfeed
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
# 生产环境必须替换为随机字符串（建议长度 32+）
SECRET_KEY=change-me-please-in-production-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 允许的来源列表，逗号分隔；写 "*" 则全部放行
CORS_ORIGINS=*

# ---------- OpenAI (deprecated — 请使用下方 LLM_* 统一入口) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# ---------- LLM 摘要（统一入口；任一 API_KEY 非空即启用） ----------
# provider: openai | qwen | deepseek
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=600
LLM_MAX_CHARS=12000
LLM_TIMEOUT_SECONDS=60

# ---------- Embedding（向量检索用） ----------
# provider: openai | qwen
# 为空时：自动回退到 pseudo_hash（关键词哈希向量），不影响系统启动
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_TIMEOUT_SECONDS=30

# ---------- Agent ----------
AGENT_TIMEOUT_SECONDS=600
AGENT_MAX_RETRIES=3
FETCHER_CONCURRENCY=5

# ---------- Email (SMTP) ----------
# 示例：QQ 邮箱 —— password 为邮箱设置中生成的"授权码"，不是登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-authorization-code
SMTP_FROM=your-email@qq.com
SMTP_USE_TLS=true

# ---------- Webhook (企业微信 / 钉钉) ----------
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR-KEY-HERE
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR-TOKEN-HERE
DINGTALK_SECRET=YOUR-SECRET-HERE

# ---------- Schedule ----------
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Shanghai
FETCH_WINDOW_HOURS=24
